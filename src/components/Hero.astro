---
// src/components/Hero.astro
import { ChevronRight } from "lucide-react";
---

<section
    class="relative pt-24 pb-20 lg:pt-24 lg:pb-32 overflow-hidden flex flex-col items-center min-h-[90vh]"
>
    <!-- Decorative Background Gradients -->
    <div class="absolute inset-0 z-0 pointer-events-none">
        <div
            class="absolute -top-[20%] -left-[10%] w-[50%] h-[50%] rounded-full bg-dev-accent/10 blur-[120px]"
        >
        </div>
        <div
            class="absolute top-[20%] -right-[10%] w-[40%] h-[40%] rounded-full bg-blue-400/10 blur-[100px]"
        >
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
        <div class="lg:grid lg:grid-cols-2 lg:gap-12 items-center">
            <!-- Hero Text Content -->
            <div
                class="mb-16 lg:mb-0 hero-entry text-center lg:text-left"
                style="opacity: 0; transform: translateY(40px);"
            >
                <div class="label-mono text-dev-accent mb-4">INGENIERÍA DE VANGUARDIA</div>
                <h1
                    class="text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tighter text-white mb-8 leading-[1.0] text-shadow-strong text-wrap-balance"
                >
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-fuchsia-200 via-fuchsia-400 to-dev-accent saturate-150 drop-shadow-[0_0_10px_rgba(217,70,239,0.3)]">IDEAS</span> <br /> 
                    CON ALMA <br />
                    <span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-blue-300 via-indigo-400 to-white hover:to-fuchsia-300 transition-colors duration-500"
                        >DIGITAL</span
                    >
                </h1>
                <p
                    class="mt-6 text-xl text-slate-400 max-w-2xl mx-auto lg:mx-0 font-normal text-pretty text-shadow-subtle"
                >
                    Elevamos el potencial de su negocio con software de alta fidelidad, <br class="hidden lg:block"/>
                    fusionando visión estratégica e inteligencia artificial de vanguardia.
                </p>

                <div
                    class="mt-12 flex flex-col sm:flex-row justify-center lg:justify-start gap-6"
                >
                    <a
                        href="#contact"
                        class="inline-flex items-center justify-center px-10 py-4 border border-white/10 text-sm label-mono rounded-none text-white bg-dev-accent hover:bg-violet-600 shadow-2xl shadow-dev-accent/20 hover:shadow-dev-accent/50 hover:scale-105 transition-all duration-500"
                    >
                        INICIAR PROYECTO
                        <ChevronRight className="ml-2 w-4 h-4" />
                    </a>
                    <a
                        href="#portfolio"
                        class="inline-flex items-center justify-center px-10 py-4 border border-white/10 text-sm label-mono text-slate-300 bg-white/5 hover:bg-white/10 hover:text-white transition-all duration-500 backdrop-blur-md"
                    >
                        PORTAFOLIO
                    </a>
                </div>
            </div>

            <!-- Empty space for WebGL Object -->
            <div
                class="hero-entry visual-container h-[400px] lg:h-[600px]"
                style="opacity: 0; transform: translateY(40px);"
            >
            </div>
        </div>
    </div>
</section>

<script>
    import gsap from "gsap";

    // Initial load animation mimicking dala.craftedbygc.com using GSAP
    document.addEventListener("DOMContentLoaded", () => {
        gsap.to(".hero-entry", {
            opacity: 1,
            y: 0,
            duration: 0.8,
            stagger: 0.2,
            ease: "power2.out",
            force3D: true, // Ensure hardware acceleration
        });
    });
</script>
