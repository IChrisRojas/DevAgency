---
// src/components/Hero.astro
import { ChevronRight } from "lucide-react";
---

<section
    class="relative pt-24 pb-20 lg:pt-24 lg:pb-32 overflow-hidden flex flex-col items-center min-h-[90vh]"
>
    <!-- Decorative Background Gradients -->
    <div class="absolute inset-0 z-0 pointer-events-none">
        <div
            class="absolute -top-[20%] -left-[10%] w-[50%] h-[50%] rounded-full bg-dev-accent/10 blur-[120px]"
        >
        </div>
        <div
            class="absolute top-[20%] -right-[10%] w-[40%] h-[40%] rounded-full bg-blue-400/10 blur-[100px]"
        >
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
        <div class="lg:grid lg:grid-cols-2 lg:gap-12 items-center">
            <!-- Hero Text Content -->
            <div
                class="mb-16 lg:mb-0 hero-entry text-center lg:text-left"
                style="opacity: 0; transform: translateY(40px);"
            >
                <h1
                    class="text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight text-white mb-6 leading-tight"
                >
                    Transformamos ideas en <br />
                    <span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-dev-accent to-blue-500 hover:to-yellow-400 transition-colors duration-500"
                        >Soluciones Digitales</span
                    >
                </h1>
                <p
                    class="mt-6 text-xl text-slate-300 max-w-2xl mx-auto lg:mx-0 font-light"
                >
                    Ingeniería de software para el futuro de tu negocio.
                    Desarrollamos aplicaciones móviles, plataformas web y
                    software a medida que impulsan tu crecimiento.
                </p>

                <div
                    class="mt-10 flex flex-col sm:flex-row justify-center lg:justify-start gap-4"
                >
                    <a
                        href="#contact"
                        class="inline-flex items-center justify-center px-8 py-3.5 border border-transparent text-base font-medium rounded-full text-white bg-dev-accent hover:bg-violet-600 shadow-lg shadow-dev-accent/20 hover:shadow-dev-accent/40 hover:scale-105 transition-all duration-300"
                    >
                        Inicia tu proyecto
                        <ChevronRight className="ml-2 w-5 h-5" />
                    </a>
                    <a
                        href="#portfolio"
                        class="inline-flex items-center justify-center px-8 py-3.5 border border-slate-600 text-base font-medium rounded-full text-slate-300 bg-transparent hover:bg-slate-800 hover:text-white transition-colors backdrop-blur-sm"
                    >
                        Ver nuestro trabajo
                    </a>
                </div>
            </div>

            <!-- Empty space for WebGL Object -->
            <div
                class="hero-entry visual-container h-[400px] lg:h-[600px]"
                style="opacity: 0; transform: translateY(40px);"
            >
            </div>
        </div>
    </div>
</section>

<script>
    import gsap from "gsap";

    // Initial load animation mimicking dala.craftedbygc.com using GSAP
    document.addEventListener("DOMContentLoaded", () => {
        gsap.to(".hero-entry", {
            opacity: 1,
            y: 0,
            duration: 0.8,
            stagger: 0.2,
            ease: "power2.out",
            force3D: true, // Ensure hardware acceleration
        });
    });
</script>
