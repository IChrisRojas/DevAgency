---
// src/components/WhyChooseUs.astro
import { CheckCircle2 } from "lucide-react";

const reasons = [
    "Stack tecnológico de vanguardia",
    "Ingeniería impulsada por el diseño",
    "Procesos de integración perfectos",
    "Mantenimiento continuo y soporte",
];
---

<section id="why-us" class="py-24 bg-transparent relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Content -->
        <div
            class="why-us-text glass-text-protection text-center"
            style="opacity: 0; transform: translateY(40px);"
        >
            <h2 class="label-mono text-dev-accent mb-4">DIFERENCIACIÓN</h2>
            <p
                class="mt-2 text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tighter text-white text-shadow-strong leading-[0.9]"
            >
                LA VISIÓN <br />
                <span class="text-white">EJECUTADA</span>
            </p>
            <p
                class="mt-8 text-xl text-slate-300 font-normal mb-12 text-shadow-subtle text-pretty leading-relaxed max-w-2xl mx-auto"
            >
                Donde otros ven código, nosotros vemos activos estratégicos.
                Combinamos ingeniería de software de grado militar con diseño
                centrado en el usuario para crear productos que no solo
                funcionan, sino que lideran su industria.
            </p>

            <ul class="space-y-6 inline-block text-left">
                {
                    reasons.map((reason) => (
                        <li
                            class="flex items-center text-slate-300 label-mono text-xs why-us-item"
                            style="opacity: 0; transform: translateX(-20px);"
                        >
                            <div
                                class="w-2 h-2 bg-dev-accent mr-4 flex-shrink-0"
                                aria-hidden="true"
                            />
                            {reason}
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</section>

<script>
    import gsap from "gsap";
    import ScrollTrigger from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const tl = gsap.timeline({
            scrollTrigger: {
                trigger: "#why-us",
                start: "top 80%",
                toggleActions: "play none none none",
            },
        });

        tl.to(".why-us-text", {
            opacity: 1,
            y: 0,
            duration: 0.8,
            ease: "power2.out",
        }).to(
            ".why-us-item",
            {
                opacity: 1,
                x: 0,
                duration: 0.5,
                stagger: 0.1,
                ease: "power2.out",
            },
            "-=0.4",
        );
    });
</script>
