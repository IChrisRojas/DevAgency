---
// src/components/WhyChooseUs.astro
import { CheckCircle2 } from "lucide-react";

const reasons = [
    "Stack tecnológico de vanguardia",
    "Ingeniería impulsada por el diseño",
    "Procesos de integración perfectos",
    "Mantenimiento continuo y soporte",
];
---

<section id="why-us" class="py-24 bg-transparent relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="lg:grid lg:grid-cols-2 lg:gap-24 items-center">
            <!-- Content -->
            <div
                class="mb-16 lg:mb-0 why-us-text glass-text-protection"
                style="opacity: 0; transform: translateY(40px);"
            >
                <h2 class="label-mono text-dev-accent mb-4">DIFERENCIACIÓN</h2>
                <p
                    class="mt-2 text-6xl font-extrabold tracking-tighter text-white sm:text-7xl text-shadow-strong leading-[0.9]"
                >
                    LA VISIÓN <br /> <span class="text-white">EJECUTADA</span>
                </p>
                <p class="mt-8 text-xl text-slate-300 font-normal mb-12 text-shadow-subtle text-pretty leading-relaxed">
                    Donde otros ven código, nosotros vemos activos estratégicos. Combinamos ingeniería de software de grado militar con diseño centrado en el usuario para crear productos que no solo funcionan, sino que lideran su industria.
                </p>

                <ul class="space-y-6">
                    {
                        reasons.map((reason) => (
                            <li
                                class="flex items-center text-slate-300 label-mono text-xs why-us-item"
                                style="opacity: 0; transform: translateX(-20px);"
                            >
                                <div class="w-2 h-2 bg-dev-accent mr-4 flex-shrink-0" aria-hidden="true"></div>
                                {reason}
                            </li>
                        ))
                    }
                </ul>
            </div>

            <!-- Image / Abstract Visual -->
            <div
                class="relative why-us-visual"
                style="opacity: 0; transform: scale(0.95);"
            >
                <div
                    class="aspect-square rounded-none bg-white/[0.03] backdrop-blur-2xl border border-white/5 shadow-2xl overflow-hidden relative flex items-center justify-center p-12"
                >
                    <!-- Abstract representation of connected systems -->
                    <div
                        class="w-full h-full relative border border-white/5 bg-black/40 flex flex-col p-8"
                    >
                        <div class="w-1/3 h-[1px] bg-dev-accent mb-12 shadow-[0_0_15px_rgba(139,92,246,0.5)]">
                        </div>
                        <div class="space-y-6">
                            <div class="w-full h-[1px] bg-white/10">
                            </div>
                            <div class="w-5/6 h-[1px] bg-white/10">
                            </div>
                            <div class="w-4/6 h-[1px] bg-white/10">
                            </div>
                        </div>
                        <div
                            class="absolute bottom-10 right-10 w-24 h-24 border border-dev-accent/20 rounded-none flex items-center justify-center group"
                        >
                            <div
                                class="w-12 h-12 bg-dev-accent/20 border border-dev-accent animate-pulse shadow-[0_0_30px_rgba(139,92,246,0.3)]"
                            >
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Decoration behind image -->
                <div
                    class="absolute -top-10 -right-10 w-48 h-48 bg-dev-accent/10 rounded-full blur-[100px] -z-10"
                >
                </div>
                <div
                    class="absolute -bottom-10 -left-10 w-64 h-64 bg-blue-500/10 rounded-full blur-[120px] -z-10"
                >
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import gsap from "gsap";
    import ScrollTrigger from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const tl = gsap.timeline({
            scrollTrigger: {
                trigger: "#why-us",
                start: "top 80%",
                toggleActions: "play none none none"
            }
        });

        tl.to(".why-us-text", {
            opacity: 1,
            y: 0,
            duration: 0.8,
            ease: "power2.out"
        })
        .to(".why-us-visual", {
            opacity: 1,
            scale: 1,
            duration: 0.8,
            ease: "power2.out"
        }, "-=0.6")
        .to(".why-us-item", {
            opacity: 1,
            x: 0,
            duration: 0.5,
            stagger: 0.1,
            ease: "power2.out"
        }, "-=0.4");
    });
</script>
