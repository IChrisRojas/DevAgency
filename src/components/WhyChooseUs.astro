---
// src/components/WhyChooseUs.astro
import { CheckCircle2 } from "lucide-react";

const reasons = [
    "Bleeding-edge technology stack",
    "Design-driven engineering",
    "Seamless integration processes",
    "Continuous maintenance & support",
];
---

<section id="why-us" class="py-24 bg-transparent relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="lg:grid lg:grid-cols-2 lg:gap-16 items-center">
            <!-- Content -->
            <div
                class="mb-12 lg:mb-0 why-us-text"
                style="opacity: 0; transform: translateY(40px);"
            >
                <h2
                    class="text-sm font-semibold text-dev-accent tracking-wide uppercase"
                >
                    The DevAgency Difference
                </h2>
                <p
                    class="mt-2 text-3xl leading-8 font-extrabold tracking-tight text-white sm:text-4xl"
                >
                    We take the guesswork out of your work
                </p>
                <p class="mt-4 text-lg text-slate-300 font-light mb-8">
                    The impossible battle to make sense of scattered systems
                    leaves teams feeling overwhelmed. We connect your fragmented
                    tools behind the scenes, pulling together elegant contextual
                    views that advance your business and help you make better
                    decisions with more confidence.
                </p>

                <ul class="space-y-4">
                    {
                        reasons.map((reason) => (
                            <li
                                class="flex items-center text-slate-300 font-medium why-us-item"
                                style="opacity: 0; transform: translateX(-20px);"
                            >
                                <CheckCircle2 className="w-5 h-5 text-dev-accent mr-3 flex-shrink-0" />
                                {reason}
                            </li>
                        ))
                    }
                </ul>
            </div>

            <!-- Image / Abstract Visual -->
            <div
                class="relative why-us-visual"
                style="opacity: 0; transform: scale(0.95);"
            >
                <div
                    class="aspect-square rounded-3xl bg-slate-900/50 backdrop-blur-sm border border-slate-700 shadow-2xl overflow-hidden relative flex items-center justify-center p-8"
                >
                    <!-- Abstract representation of connected systems -->
                    <div
                        class="w-full h-full relative border border-slate-700 rounded-2xl bg-slate-800 shadow-sm flex flex-col p-6"
                    >
                        <div class="w-1/3 h-4 bg-slate-700 rounded-full mb-8">
                        </div>
                        <div class="space-y-4">
                            <div class="w-full h-3 bg-slate-600 rounded-full">
                            </div>
                            <div class="w-5/6 h-3 bg-slate-600 rounded-full">
                            </div>
                            <div class="w-4/6 h-3 bg-slate-600 rounded-full">
                            </div>
                        </div>
                        <div
                            class="absolute bottom-6 right-6 w-16 h-16 bg-dev-accent/20 rounded-full flex items-center justify-center"
                        >
                            <div
                                class="w-8 h-8 bg-dev-accent rounded-full animate-pulse shadow-[0_0_15px_rgba(139,92,246,0.5)]"
                            >
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Decoration behind image -->
                <div
                    class="absolute -top-6 -right-6 w-32 h-32 bg-blue-100/50 rounded-full blur-2xl -z-10"
                >
                </div>
                <div
                    class="absolute -bottom-8 -left-8 w-40 h-40 bg-purple-100/50 rounded-full blur-2xl -z-10"
                >
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import gsap from "gsap";
    import ScrollTrigger from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const tl = gsap.timeline({
            scrollTrigger: {
                trigger: "#why-us",
                start: "top 80%",
                toggleActions: "play none none none"
            }
        });

        tl.to(".why-us-text", {
            opacity: 1,
            y: 0,
            duration: 0.8,
            ease: "power2.out"
        })
        .to(".why-us-visual", {
            opacity: 1,
            scale: 1,
            duration: 0.8,
            ease: "power2.out"
        }, "-=0.6")
        .to(".why-us-item", {
            opacity: 1,
            x: 0,
            duration: 0.5,
            stagger: 0.1,
            ease: "power2.out"
        }, "-=0.4");
    });
</script>
