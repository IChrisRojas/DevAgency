---
// src/components/Portfolio.astro
import { getCollection } from "astro:content";
import { ArrowUpRight } from "lucide-react";

const projects = await getCollection("projects");
---

<section id="portfolio" class="py-24 bg-transparent relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div
            class="flex flex-col md:flex-row md:items-end justify-between mb-16 portfolio-reveal"
            style="opacity: 0; transform: translateY(40px);"
        >
            <div class="max-w-2xl">
                <h2
                    class="text-sm font-semibold text-dev-accent tracking-wide uppercase"
                >
                    Nuestro Trabajo
                </h2>
                <p
                    class="mt-2 text-3xl leading-8 font-extrabold tracking-tight text-white sm:text-4xl"
                >
                    Proyectos destacados
                </p>
            </div>
            <div class="mt-6 md:mt-0">
                <a
                    href="#"
                    class="text-dev-accent font-medium hover:text-violet-700 flex items-center transition-colors group"
                >
                    Ver todos los proyectos
                    <ArrowUpRight
                        className="w-4 h-4 ml-1 transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform"
                    />
                </a>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {
                projects.map((project, index) => (
                    <a
                        href={project.data.link || "#"}
                        class="project-card block group cursor-pointer"
                        style="opacity: 0; transform: translateY(40px);"
                    >
                        <div class="relative overflow-hidden rounded-2xl bg-slate-900/50 backdrop-blur-sm aspect-[4/3] mb-6 border border-white/10">
                            {/* Fallback image placeholder since we don't have actual images in the template */}
                            <div class="absolute inset-0 bg-slate-800 flex items-center justify-center p-8 group-hover:scale-105 transition-transform duration-700 ease-out">
                                <div class="w-full h-full bg-slate-900 rounded-xl shadow-sm border border-white/10 p-4 flex flex-col justify-between opacity-80 group-hover:opacity-100 transition-opacity">
                                    <div class="flex gap-2">
                                        <div class="w-2.5 h-2.5 rounded-full bg-slate-700" />
                                        <div class="w-2.5 h-2.5 rounded-full bg-slate-700" />
                                        <div class="w-2.5 h-2.5 rounded-full bg-slate-700" />
                                    </div>
                                    <div class="w-3/4 h-2 bg-slate-700 rounded mt-auto" />
                                    <div class="w-1/2 h-2 bg-slate-700 rounded mt-2" />
                                </div>
                            </div>
                        </div>

                        <div class="flex flex-wrap gap-2 mb-3">
                            {project.data.tags.map((tag) => (
                                <span class="inline-flex items-center rounded-full bg-slate-800 px-2.5 py-0.5 text-xs font-medium text-slate-300 border border-white/10">
                                    {tag}
                                </span>
                            ))}
                        </div>
                        <h3 class="text-xl font-bold text-white mb-2 group-hover:text-dev-accent transition-colors">
                            {project.data.title}
                        </h3>
                        <p class="text-slate-400 font-light line-clamp-2">
                            {project.data.description}
                        </p>
                    </a>
                ))
            }
        </div>
    </div>
</section>

<script>
    import gsap from "gsap";
    import ScrollTrigger from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const tl = gsap.timeline({
            scrollTrigger: {
                trigger: "#portfolio",
                start: "top 80%",
                toggleActions: "play none none none"
            }
        });

        tl.to(".portfolio-reveal", {
            opacity: 1,
            y: 0,
            duration: 0.8,
            ease: "power2.out"
        })
        .to(".project-card", {
            opacity: 1,
            y: 0,
            duration: 0.8,
            stagger: 0.15,
            ease: "power2.out",
            force3D: true
        }, "-=0.4");
    });
</script>
