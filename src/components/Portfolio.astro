---
// src/components/Portfolio.astro
import { getCollection } from "astro:content";
import { ArrowUpRight } from "lucide-react";

const projects = await getCollection("projects");
---

<section id="portfolio" class="py-24 bg-transparent relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div
            class="flex flex-col md:flex-row md:items-end justify-between mb-24 portfolio-reveal glass-text-protection w-full"
            style="opacity: 0; transform: translateY(40px);"
        >
            <div class="max-w-3xl">
                <h2 class="label-mono text-dev-accent mb-4">CASOS DE ESTUDIO</h2>
                <p
                    class="mt-2 text-6xl font-extrabold tracking-tighter text-white sm:text-7xl text-shadow-strong leading-[0.9]"
                >
                    PORTAFOLIO <br /> <span class="text-white">SELECCIONADO</span>
                </p>
            </div>
            <div class="mt-8 md:mt-0">
                <a
                    href="#"
                    class="text-dev-accent label-mono text-xs hover:text-white flex items-center transition-all group border border-dev-accent/20 px-6 py-3 hover:bg-dev-accent"
                >
                    VER TODO
                    <ArrowUpRight
                        className="w-4 h-4 ml-2 transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform"
                    />
                </a>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
            {
                projects.map((project, index) => (
                    <a
                        href={project.data.link || "#"}
                        class="project-card block group cursor-pointer"
                        style="opacity: 0; transform: translateY(40px);"
                    >
                        <div class="relative overflow-hidden rounded-none bg-white/[0.03] backdrop-blur-sm aspect-[4/5] mb-8 border border-white/5 group-hover:border-dev-accent/30 transition-all duration-700">
                            {/* Fallback image placeholder */}
                            <div class="absolute inset-0 bg-white/[0.01] flex items-center justify-center p-12 group-hover:scale-105 transition-transform duration-1000 ease-out">
                                <div class="w-full h-full bg-black/40 rounded-none border border-white/5 p-6 flex flex-col justify-between opacity-50 group-hover:opacity-100 transition-opacity">
                                    <div class="flex gap-2">
                                        <div class="w-1.5 h-1.5 rounded-full bg-white/20" />
                                        <div class="w-1.5 h-1.5 rounded-full bg-white/20" />
                                        <div class="w-1.5 h-1.5 rounded-full bg-white/20" />
                                    </div>
                                    <div class="space-y-3">
                                        <div class="w-full h-[1px] bg-white/10" />
                                        <div class="w-2/3 h-[1px] bg-white/10" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="flex flex-wrap gap-3 mb-6">
                            {project.data.tags.map((tag) => (
                                <span class="label-mono text-[8px] px-3 py-1 bg-white/5 text-slate-400 border border-white/5">
                                    {tag}
                                </span>
                            ))}
                        </div>
                        <h3 class="text-3xl font-extrabold text-white mb-3 group-hover:text-dev-accent transition-colors tracking-tighter text-shadow-strong">
                            {project.data.title}
                        </h3>
                        <p class="text-slate-300 font-normal line-clamp-2 text-shadow-subtle text-pretty">
                            {project.data.description}
                        </p>
                    </a>
                ))
            }
        </div>
    </div>
</section>

<script>
    import gsap from "gsap";
    import ScrollTrigger from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const tl = gsap.timeline({
            scrollTrigger: {
                trigger: "#portfolio",
                start: "top 80%",
                toggleActions: "play none none none"
            }
        });

        tl.to(".portfolio-reveal", {
            opacity: 1,
            y: 0,
            duration: 0.8,
            ease: "power2.out"
        })
        .to(".project-card", {
            opacity: 1,
            y: 0,
            duration: 0.8,
            stagger: 0.15,
            ease: "power2.out",
            force3D: true
        }, "-=0.4");
    });
</script>
