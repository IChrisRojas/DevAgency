---
// src/components/Portfolio.astro
import { getCollection } from "astro:content";
import { ArrowUpRight } from "lucide-react";

const projects = await getCollection("projects");
---

<section id="portfolio" class="py-24 bg-transparent relative overflow-hidden" style="scroll-margin-top: 80px;">
    <!-- Decorative transition blob -->
    <div
        class="hidden lg:block absolute bottom-0 right-0 translate-y-1/2 translate-x-1/4 pointer-events-none z-0"
    >
        <div
            class="w-[600px] h-[600px] bg-dev-accent/15 rounded-full blur-[120px]"
        >
        </div>
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div
            class="flex flex-col md:flex-row md:items-end justify-between mb-24 portfolio-reveal glass-text-protection w-full"
            style="opacity: 0; transform: translateY(40px);"
        >
            <div class="max-w-3xl">
                <h2 class="label-mono text-dev-accent mb-4">
                    CASOS DE ESTUDIO
                </h2>
                <p
                    class="mt-2 text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tighter text-white sm:text-7xl text-shadow-strong leading-none md:leading-[0.9]"
                >
                    PORTAFOLIO <br />
                    <span class="text-white">SELECCIONADO</span>
                </p>
            </div>
            <div class="mt-8 md:mt-0">
                <a
                    href="#"
                    class="text-dev-accent label-mono text-xs hover:text-white flex items-center transition-all group border border-dev-accent/20 px-6 py-3 hover:bg-dev-accent"
                >
                    VER TODO
                    <ArrowUpRight
                        className="w-4 h-4 ml-2 transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform"
                    />
                </a>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
            {
                projects.map((project, index) => (
                    <a
                        href={project.data.link || "#"}
                        class={`project-card group cursor-pointer block`}
                        style="opacity: 0; transform: translateY(40px);"
                    >
                        <div class="relative overflow-hidden rounded-none bg-white/[0.03] backdrop-blur-sm aspect-[4/5] mb-8 border border-white/5 group-hover:border-dev-accent/30 transition-all duration-700">
                            <div class="absolute inset-0 bg-white/[0.01] overflow-hidden group-hover:scale-105 transition-transform duration-1000 ease-out">
                                <img
                                    src={project.data.image}
                                    alt={`Captura de pantalla de ${project.data.title}`}
                                    class="w-full h-full object-cover object-top opacity-60 group-hover:opacity-100 transition-opacity duration-700"
                                />
                                {/* Overlay for better text readability and premium feel */}
                                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-60" />
                            </div>
                        </div>

                        <div class="flex flex-wrap gap-3 mb-6">
                            {project.data.tags.map((tag) => (
                                <span class="label-mono text-[8px] px-3 py-1 bg-white/5 text-slate-400 border border-white/5">
                                    {tag}
                                </span>
                            ))}
                        </div>
                        <h3 class="text-3xl font-extrabold text-white mb-3 group-hover:text-dev-accent transition-colors tracking-tighter text-shadow-strong">
                            {project.data.title}
                        </h3>
                        <p class="text-slate-300 font-normal line-clamp-2 text-shadow-subtle text-pretty">
                            {project.data.description}
                        </p>
                    </a>
                ))
            }
        </div>
    </div>
</section>

<script>
    import gsap from "gsap";
    import ScrollTrigger from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.querySelectorAll('.portfolio-reveal, .project-card').forEach(el => {
                (el as HTMLElement).style.opacity = '1';
                (el as HTMLElement).style.transform = 'none';
            });
            return;
        }

        const tl = gsap.timeline({
            scrollTrigger: {
                trigger: "#portfolio",
                start: "top 80%",
                toggleActions: "play none none none",
            },
        });

        tl.to(".portfolio-reveal", {
            opacity: 1,
            y: 0,
            duration: 0.8,
            ease: "power2.out",
        }).to(
            ".project-card",
            {
                opacity: 1,
                y: 0,
                duration: 0.8,
                stagger: 0.15,
                ease: "power2.out",
                force3D: true,
            },
            "-=0.4",
        );
    });
</script>
