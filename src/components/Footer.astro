---
// src/components/Footer.astro
const year = new Date().getFullYear();
---

<footer class="bg-transparent text-slate-300 border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
            <div class="col-span-1 md:col-span-2">
                <a
                    href="/"
                    class="text-2xl font-bold text-white mb-4 inline-block"
                >
                    DevAgency
                </a>
                <p class="text-slate-400 max-w-sm mt-2">
                    Building smart, scalable, and premium digital solutions that
                    drive business growth. Your vision, our engineering.
                </p>
            </div>
            <div>
                <h3
                    class="text-sm font-semibold text-white tracking-wider uppercase mb-4"
                >
                    Company
                </h3>
                <ul class="space-y-3">
                    <li>
                        <a
                            href="#services"
                            class="hover:text-dev-accent transition-colors"
                            >Services</a
                        >
                    </li>
                    <li>
                        <a
                            href="#portfolio"
                            class="hover:text-dev-accent transition-colors"
                            >Portfolio</a
                        >
                    </li>
                    <li>
                        <a
                            href="#why-us"
                            class="hover:text-dev-accent transition-colors"
                            >Why Choose Us</a
                        >
                    </li>
                </ul>
            </div>
            <div>
                <h3
                    class="text-sm font-semibold text-white tracking-wider uppercase mb-4"
                >
                    Connect
                </h3>
                <ul class="space-y-3">
                    <li>
                        <a
                            href="#"
                            class="hover:text-dev-accent transition-colors"
                            >Twitter</a
                        >
                    </li>
                    <li>
                        <a
                            href="#"
                            class="hover:text-dev-accent transition-colors"
                            >LinkedIn</a
                        >
                    </li>
                    <li>
                        <a
                            href="#"
                            class="hover:text-dev-accent transition-colors"
                            >GitHub</a
                        >
                    </li>
                </ul>
            </div>
        </div>
        <div
            class="mt-12 pt-8 border-t border-slate-800 text-center text-sm text-slate-500"
        >
            &copy; {year} DevAgency. All rights reserved.
        </div>
    </div>
</footer>
