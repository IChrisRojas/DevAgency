---
// src/components/Footer.astro
const year = new Date().getFullYear();
---

<footer
    class="bg-black/50 backdrop-blur-md text-slate-300 border-t border-white/10 relative z-10"
>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
        <div class="hidden md:grid grid-cols-1 md:grid-cols-4 gap-8">
            <div class="col-span-1 md:col-span-2">
                <a
                    href="/"
                    class="flex items-center gap-0 group mb-4 w-fit select-none"
                    aria-label="SolucionAI"
                >
                    <span class="w-[3px] h-6 bg-dev-accent mr-2.5 shrink-0" aria-hidden="true"></span>
                    <span
                        class="font-[family-name:var(--font-rajdhani)] font-black text-[1.35rem] tracking-[0.18em] uppercase leading-none"
                        style="text-shadow: 0 0 18px rgba(139,92,246,0.5), 0 0 40px rgba(139,92,246,0.25); color: #a78bfa;"
                    >SOLUCION</span>
                    <span
                        class="font-[family-name:var(--font-rajdhani)] font-black text-[1.35rem] uppercase leading-none ml-[2px] px-[5px] py-[1px] border border-dev-accent/60 text-white"
                        style="letter-spacing: 0.14em;"
                    >AI</span>
                </a>
                <p class="text-slate-300 max-w-sm mt-2">
                    Construimos el futuro con código inteligente. Desarrollo de
                    software de alto impacto y soluciones de IA que transforman
                    negocios.
                </p>
            </div>
            <div>
                <h3
                    class="text-sm font-semibold text-white tracking-wider uppercase mb-4"
                >
                    Expertise
                </h3>
                <ul class="space-y-3">
                    <li>
                        <a
                            href="#services"
                            class="hover:text-dev-accent transition-colors"
                            >Desarrollo Web</a
                        >
                    </li>
                    <li>
                        <a
                            href="#services"
                            class="hover:text-dev-accent transition-colors"
                            >IA & Machine Learning</a
                        >
                    </li>
                    <li>
                        <a
                            href="#portfolio"
                            class="hover:text-dev-accent transition-colors"
                            >Proyectos</a
                        >
                    </li>
                </ul>
            </div>
            <div>
                <h3
                    class="text-sm font-semibold text-white tracking-wider uppercase mb-4"
                >
                    Conectemos
                </h3>
                <ul class="space-y-3">
                    <li>
                        <a
                            href="#"
                            class="hover:text-dev-accent transition-colors"
                            >Twitter</a
                        >
                    </li>
                    <li>
                        <a
                            href="#"
                            class="hover:text-dev-accent transition-colors"
                            >LinkedIn</a
                        >
                    </li>
                    <li>
                        <a
                            href="#"
                            class="hover:text-dev-accent transition-colors"
                            >GitHub</a
                        >
                    </li>
                </ul>
            </div>
        </div>
        <div
            class="mt-0 md:mt-12 pt-0 md:pt-8 border-t-0 md:border-t border-white/10 text-center text-xs md:text-sm text-slate-400"
        >
            &copy; {year} solucionAI. Todos los derechos reservados.
        </div>
    </div>
</footer>
