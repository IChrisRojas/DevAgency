---
// src/components/Footer.astro
const year = new Date().getFullYear();
---

<footer
    class="bg-black/50 backdrop-blur-md text-slate-300 border-t border-white/10 relative z-10"
>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
            <div class="col-span-1 md:col-span-2">
                <a
                    href="/"
                    class="text-2xl font-bold text-white mb-4 inline-block"
                >
                    DevAgency
                </a>
                <p class="text-slate-300 max-w-sm mt-2">
                    Transformamos ideas en soluciones digitales. Desarrollo de
                    software a medida, aplicaciones y plataformas web para el
                    futuro de tu negocio.
                </p>
            </div>
            <div>
                <h3
                    class="text-sm font-semibold text-white tracking-wider uppercase mb-4"
                >
                    Compañía
                </h3>
                <ul class="space-y-3">
                    <li>
                        <a
                            href="#services"
                            class="hover:text-dev-accent transition-colors"
                            >Servicios</a
                        >
                    </li>
                    <li>
                        <a
                            href="#portfolio"
                            class="hover:text-dev-accent transition-colors"
                            >Portafolio</a
                        >
                    </li>
                    <li>
                        <a
                            href="#why-us"
                            class="hover:text-dev-accent transition-colors"
                            >Por qué Elegirnos</a
                        >
                    </li>
                </ul>
            </div>
            <div>
                <h3
                    class="text-sm font-semibold text-white tracking-wider uppercase mb-4"
                >
                    Conectar
                </h3>
                <ul class="space-y-3">
                    <li>
                        <a
                            href="#"
                            class="hover:text-dev-accent transition-colors"
                            >Twitter</a
                        >
                    </li>
                    <li>
                        <a
                            href="#"
                            class="hover:text-dev-accent transition-colors"
                            >LinkedIn</a
                        >
                    </li>
                    <li>
                        <a
                            href="#"
                            class="hover:text-dev-accent transition-colors"
                            >GitHub</a
                        >
                    </li>
                </ul>
            </div>
        </div>
        <div
            class="mt-12 pt-8 border-t border-white/10 text-center text-sm text-slate-300"
        >
            &copy; {year} DevAgency. Todos los derechos reservados.
        </div>
    </div>
</footer>
