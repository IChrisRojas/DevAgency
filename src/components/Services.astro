---
// src/components/Services.astro
import { getCollection } from "astro:content";
import { Code, Monitor, Smartphone, Lightbulb } from "lucide-react";

const services = await getCollection("services");

const iconMap: Record<string, any> = {
    Code,
    Monitor,
    Smartphone,
    Lightbulb,
};
---

<section id="services" class="py-24 bg-transparent relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div
            class="text-center max-w-2xl mx-auto mb-16 scroll-reveal"
            style="opacity: 0; transform: translateY(40px);"
        >
            <h2
                class="text-sm font-semibold text-dev-accent tracking-wide uppercase"
            >
                Capacidades
            </h2>
            <p
                class="mt-2 text-3xl leading-8 font-extrabold tracking-tight text-white sm:text-4xl"
            >
                Experiencia que conecta los puntos
            </p>
            <p class="mt-4 max-w-2xl text-xl text-slate-400 mx-auto">
                Especializados en la construcción de sistemas robustos e integraciones
                inteligentes que trabajan juntos detrás de escena.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            {
                services.map((service, index) => {
                    const Icon = iconMap[service.data.icon] || Code;
                    return (
                        <div
                            class="service-card rounded-2xl p-8 bg-slate-900/40 border border-slate-800 backdrop-blur-sm hover:border-dev-accent/50 hover:shadow-xl hover:shadow-dev-accent/10 transition-all duration-300 transform hover:-translate-y-1 group"
                            style="opacity: 0; transform: translateY(40px);"
                        >
                            <div class="w-12 h-12 bg-slate-800 rounded-xl shadow-sm border border-slate-700 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
                                <Icon className="w-6 h-6 text-dev-accent" />
                            </div>
                            <h3 class="text-xl font-semibold text-white mb-3">
                                {service.data.title}
                            </h3>
                            <p class="text-slate-400 leading-relaxed font-light">
                                {service.data.description}
                            </p>
                        </div>
                    );
                })
            }
        </div>
    </div>
</section>

<script>
    import gsap from "gsap";
    import ScrollTrigger from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        // Reveal header
        gsap.to(".scroll-reveal", {
            scrollTrigger: {
                trigger: ".scroll-reveal",
                start: "top 85%",
                toggleActions: "play none none none"
            },
            opacity: 1,
            y: 0,
            duration: 0.8,
            ease: "power2.out",
            force3D: true
        });

        // Stagger services cards
        gsap.to(".service-card", {
            scrollTrigger: {
                trigger: "#services",
                start: "top 80%",
                toggleActions: "play none none none"
            },
            opacity: 1,
            y: 0,
            duration: 0.8,
            stagger: 0.15,
            ease: "power2.out",
            force3D: true
        });
    });
</script>
