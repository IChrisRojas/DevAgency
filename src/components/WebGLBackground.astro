---
// src/components/WebGLBackground.astro
---

<canvas
    id="webgl-canvas"
    class="fixed top-0 left-0 w-full h-full -z-10 pointer-events-none"></canvas>

<script>
    import {
        Scene,
        FogExp2,
        PerspectiveCamera,
        WebGLRenderer,
        Vector2,
        BufferGeometry,
        BufferAttribute,
        Color,
        ShaderMaterial,
        AdditiveBlending,
        Points,
        Mesh,
        Clock,
        Vector3,
    } from "three";
    import { EffectComposer } from "three/examples/jsm/postprocessing/EffectComposer.js";
    import { RenderPass } from "three/examples/jsm/postprocessing/RenderPass.js";
    import { UnrealBloomPass } from "three/examples/jsm/postprocessing/UnrealBloomPass.js";
    import { GLTFLoader } from "three/examples/jsm/loaders/GLTFLoader.js";
    import { MeshSurfaceSampler } from "three/examples/jsm/math/MeshSurfaceSampler.js";

    import gsap from "gsap";
    import ScrollTrigger from "gsap/ScrollTrigger";

    // ========== VERTEX SHADER — Partículas del modelo ==========
    const vertexShader = `
  uniform float uTime;
  uniform float uProgress;
  uniform float uExplosion;
  uniform float uSizeFactor;
  
  attribute vec3 position2;
  attribute vec3 aDirection;
  attribute vec3 customColor;
  attribute float randomOffset;
  attribute float shapeType;
  attribute float aSize;
  
  varying vec3 vColor;
  varying float vShapeType;
  varying float vOpacity;
  varying float vRandomOffset;
  
  float snoise(vec3 v) {
    return sin(v.x * 8.0) * cos(v.y * 8.0) * sin(v.z * 8.0);
  }
  
  void main() {
      vColor = customColor;
      vShapeType = shapeType;
      vRandomOffset = randomOffset;
  
      vec3 mixedPosition = mix(position, position2, uProgress);
      // Reducción drástica del ruido para que no modifique tanto la forma
      float noise = snoise(mixedPosition * 1.5 + uTime * 0.15 + randomOffset) * 0.015;
      vec3 pseudoNormal = normalize(mixedPosition);
      mixedPosition += pseudoNormal * noise;

  
      mixedPosition += aDirection * uExplosion * 2.5;
  
      // Profundidad para opacidad y coloración interior brillante
      float depth = length(mixedPosition);
      // Las partículas cerca del centro (depth pequeño) son más brillantes, las del borde más transparentes
      vOpacity = 0.5 + 0.5 * (1.0 - smoothstep(0.0, 3.5, depth));

      // Añadimos extra brillo interior para el fragment shader
      vRandomOffset = randomOffset;
      // Guardamos la profundidad en vShapeType (hackeado) para el color, 
      // pero en este caso crearemos un varying específico para el brillo
      
      vec4 mvPosition = modelViewMatrix * vec4(mixedPosition, 1.0);
      
      gl_PointSize = (uSizeFactor * aSize) * (1.0 / -mvPosition.z);
      gl_Position = projectionMatrix * mvPosition;
  }
  `;

    const fragmentShader = `
  varying vec3 vColor;
  varying float vShapeType;
  varying float vOpacity;
  varying float vRandomOffset;

  float sdTriangle(vec2 p, float r) {
      float k = sqrt(3.0);
      p.x = abs(p.x) - r;
      p.y = p.y + r / k;
      if (p.x + k * p.y > 0.0) p = vec2(p.x - k * p.y, -k * p.x - p.y) / 2.0;
      p.x -= clamp(p.x, -2.0 * r, 0.0);
      return -length(p) * sign(p.y);
  }

  float sdBox(vec2 p, vec2 b) {
      vec2 d = abs(p) - b;
      return length(max(d, 0.0)) + min(max(d.x, d.y), 0.0);
  }

  void main() {
      // Rotar polígonos individualmente 
      float angle = vRandomOffset * 6.2831;
      float s = sin(angle), c = cos(angle);
      vec2 uv = gl_PointCoord.xy - vec2(0.5);
      
      uv = vec2(uv.x * c - uv.y * s, uv.x * s + uv.y * c);

      float dist = length(uv);
      float aa = 0.05;

      float alpha = 0.0;
      vec3 colorMod = vec3(1.0);

      if (vShapeType < 0.5) {
          // Triángulo relleno (vidrio bombilla, corteza cerebro)
          float d = sdTriangle(uv, 0.28);
          alpha = 1.0 - smoothstep(-aa, 0.02, d);
          colorMod = mix(vec3(1.3), vec3(1.0), smoothstep(-0.2, 0.0, d));
      } else if (vShapeType < 1.5) {
          // Triángulo outline (vidrio, surcos cerebro)
          float d = sdTriangle(uv, 0.32);
          float thickness = 0.015;
          alpha = 1.0 - smoothstep(0.0, aa, abs(d) - thickness);
      } else if (vShapeType < 2.5) {
          // Punto brillante para filamento / núcleo cerebro (glow intenso)
          float softDist = exp(-dist * 4.0);
          alpha = smoothstep(0.0, 1.0, softDist);
          colorMod = vec3(2.5); // Extra brillo
      } else if (vShapeType < 3.5) {
          // Cuadrado rotado outline (metal bombilla / base cerebro)
          float boxAngle = 0.785;
          float bs = sin(boxAngle), bc = cos(boxAngle);
          vec2 rUv = vec2(uv.x * bc - uv.y * bs, uv.x * bs + uv.y * bc);
          float d = sdBox(rUv, vec2(0.22));
          float thickness = 0.02;
          alpha = 1.0 - smoothstep(0.0, aa, abs(d) - thickness);
          colorMod = vec3(1.6); // Más brillante para metal
      } else {
          // Punto circular suave pequeño
          float softDist = exp(-dist * 6.0);
          alpha = smoothstep(0.0, 1.0, softDist);
      }

      if (alpha < 0.01) discard;

      float interiorGlow = pow(vOpacity, 2.0) * 2.5;
      vec3 finalColor = vColor * colorMod * max(1.0, interiorGlow);
      
      gl_FragColor = vec4(finalColor, alpha * vOpacity);
  }


  `;

    // ========== SHADERS PARTÍCULAS DE FONDO ==========
    const bgVertexShader = `
  uniform float uTime;
  attribute float aSize;
  attribute vec3 aVelocity;
  attribute float aOpacity;
  attribute float aShapeType;
  attribute vec3 aColor;
  varying float vOpacity;
  varying vec3 vColor;
  varying float vShapeType;

  void main() {
      vOpacity = aOpacity;
      vColor = aColor;
      vShapeType = aShapeType;

      vec3 pos = position;
      pos += aVelocity * uTime;
      
      // Wrap around
      pos = mod(pos + 30.0, 60.0) - 30.0;

      vec4 mvPosition = modelViewMatrix * vec4(pos, 1.0);
      gl_PointSize = aSize * (250.0 / -mvPosition.z);
      gl_Position = projectionMatrix * mvPosition;
  }
  `;

    const bgFragmentShader = `
  varying float vOpacity;
  varying vec3 vColor;
  varying float vShapeType;

  float sdTriangle(vec2 p, float r) {
      float k = sqrt(3.0);
      p.x = abs(p.x) - r;
      p.y = p.y + r / k;
      if (p.x + k * p.y > 0.0) p = vec2(p.x - k * p.y, -k * p.x - p.y) / 2.0;
      p.x -= clamp(p.x, -2.0 * r, 0.0);
      return -length(p) * sign(p.y);
  }

  void main() {
      vec2 uv = gl_PointCoord.xy - vec2(0.5);
      float dist = length(uv);
      float aa = 0.04;

      float alpha = 0.0;
      if (vShapeType < 0.5) {
          // Triángulo outline
          float d = sdTriangle(vec2(uv.x, -uv.y), 0.32);
          alpha = 1.0 - smoothstep(0.0, aa, abs(d) - 0.03);
      } else if (vShapeType < 1.5) {
          // Triángulo relleno
          float d = sdTriangle(vec2(uv.x, -uv.y), 0.28);
          alpha = 1.0 - smoothstep(-aa, 0.02, d);
      } else if (vShapeType < 2.5) {
          // Punto suave
          alpha = 1.0 - smoothstep(0.0, 0.4, dist);
          alpha = pow(alpha, 1.5);
      } else {
          // Anillo
          float d = abs(dist - 0.25) - 0.02;
          alpha = 1.0 - smoothstep(0.0, aa, d);
      }

      if (alpha < 0.01) discard;
      gl_FragColor = vec4(vColor, alpha * vOpacity);
  }
  `;

    gsap.registerPlugin(ScrollTrigger);

    const canvas = document.querySelector("#webgl-canvas") as HTMLCanvasElement;
    if (canvas) {
        const scene = new Scene();
        scene.fog = new FogExp2(0x000000, 0.025);

        const camera = new PerspectiveCamera(
            75,
            window.innerWidth / window.innerHeight,
            0.1,
            1000,
        );
        camera.position.z = 5;

        const renderer = new WebGLRenderer({
            canvas,
            alpha: false,
            antialias: true,
        });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

        const renderScene = new RenderPass(scene, camera);
        const composer = new EffectComposer(renderer);
        composer.addPass(renderScene);

        const isMobile =
            /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(
                navigator.userAgent,
            );

        if (!isMobile) {
            const bloomPass = new UnrealBloomPass(
                new Vector2(256, 256),
                1.5,
                0.4,
                0.85,
            );
            bloomPass.threshold = 0.85; // Solo las más brillantes generan glow
            bloomPass.strength = 0.35; // Bloom muy sutil
            bloomPass.radius = 0.25;
            composer.addPass(bloomPass);
        }

        // ========== PARTÍCULAS DEL MODELO (menor densidad para que se aprecie la forma nítida) ==========
        const particleCount = isMobile ? 1500 : 4000;

        const positions1 = new Float32Array(particleCount * 3);
        const positions2 = new Float32Array(particleCount * 3);
        const shapeTypes = new Float32Array(particleCount);
        const aSizes = new Float32Array(particleCount);
        const directions = new Float32Array(particleCount * 3);
        const colors = new Float32Array(particleCount * 3);
        const randomOffsets = new Float32Array(particleCount);

        // Paleta de colores ajustada inspirada en la referencia Dala
        const colorPalette = [
            new Color(0xfbbf24), // Dorado/Amarillo
            new Color(0xf59e0b), // Ámbar
            new Color(0x8b5cf6), // Púrpura vibrante
            new Color(0x06b6d4), // Cyan
            new Color(0xffffff), // Blanco
            new Color(0x6d28d9), // Púrpura oscuro
        ];

        for (let i = 0; i < particleCount; i++) {
            positions1[i * 3] = 0;
            positions1[i * 3 + 1] = 0;
            positions1[i * 3 + 2] = 0;
            positions2[i * 3] = 0;
            positions2[i * 3 + 1] = 0;
            positions2[i * 3 + 2] = 0;

            // Shapes y colores se asignarán después, según la parte del modelo
            shapeTypes[i] = 1; // Por defecto triángulo outline (se sobreescribe en loader)

            // Tamaños mucho más reducidos... ¡Pero aumentados para que se vean bien!
            const sizeRand = Math.random();
            if (sizeRand < 0.05) {
                aSizes[i] = Math.random() * 2.5 + 1.2; // Grandes (5%)
            } else if (sizeRand < 0.25) {
                aSizes[i] = Math.random() * 1.0 + 0.6; // Medianas (20%)
            } else {
                aSizes[i] = Math.random() * 0.4 + 0.2; // Pequeñas (75%)
            }

            const theta = Math.random() * Math.PI * 2;
            const phi = Math.acos(Math.random() * 2 - 1);
            directions[i * 3] = Math.sin(phi) * Math.cos(theta);
            directions[i * 3 + 1] = Math.sin(phi) * Math.sin(theta);
            directions[i * 3 + 2] = Math.cos(phi);

            // Asignar color aleatorio de la paleta
            const color =
                colorPalette[Math.floor(Math.random() * colorPalette.length)];
            colors[i * 3] = color.r;
            colors[i * 3 + 1] = color.g;
            colors[i * 3 + 2] = color.b;

            randomOffsets[i] = Math.random();
        }

        const particlesGeometry = new BufferGeometry();
        particlesGeometry.setAttribute(
            "position",
            new BufferAttribute(positions1, 3),
        );
        particlesGeometry.setAttribute(
            "position2",
            new BufferAttribute(positions2, 3),
        );
        particlesGeometry.setAttribute(
            "aDirection",
            new BufferAttribute(directions, 3),
        );
        particlesGeometry.setAttribute(
            "customColor",
            new BufferAttribute(colors, 3),
        );
        particlesGeometry.setAttribute(
            "randomOffset",
            new BufferAttribute(randomOffsets, 1),
        );
        particlesGeometry.setAttribute(
            "shapeType",
            new BufferAttribute(shapeTypes, 1),
        );
        particlesGeometry.setAttribute("aSize", new BufferAttribute(aSizes, 1));

        let particleSystem: any;
        const loader = new GLTFLoader();

        Promise.all([
            new Promise<any>((resolve) =>
                loader.load("/models/light_bulb.glb", resolve),
            ),
            new Promise<any>((resolve) =>
                loader.load("/models/Rotten Brain.glb", resolve),
            ),
        ])
            .then(([bulbGLTF, brainGLTF]) => {
                // Recoger TODAS las meshes y crear samplers individuales
                const getSamplers = (gltf: any, targetSize: number) => {
                    const meshes: any[] = [];
                    gltf.scene.updateMatrixWorld(true);
                    gltf.scene.traverse((child: any) => {
                        if (child.isMesh) meshes.push(child);
                    });
                    if (meshes.length === 0) return null;

                    // Calcular bounding box global para centrar y normalizar
                    let minX = Infinity,
                        minY = Infinity,
                        minZ = Infinity;
                    let maxX = -Infinity,
                        maxY = -Infinity,
                        maxZ = -Infinity;
                    for (const m of meshes) {
                        const geom = m.geometry.clone();
                        geom.applyMatrix4(m.matrixWorld);
                        const posArr = geom.getAttribute("position").array;
                        for (let j = 0; j < posArr.length; j += 3) {
                            minX = Math.min(minX, posArr[j]);
                            minY = Math.min(minY, posArr[j + 1]);
                            minZ = Math.min(minZ, posArr[j + 2]);
                            maxX = Math.max(maxX, posArr[j]);
                            maxY = Math.max(maxY, posArr[j + 1]);
                            maxZ = Math.max(maxZ, posArr[j + 2]);
                        }
                    }
                    const cx = (minX + maxX) / 2,
                        cy = (minY + maxY) / 2,
                        cz = (minZ + maxZ) / 2;
                    const maxDim = Math.max(
                        maxX - minX,
                        maxY - minY,
                        maxZ - minZ,
                    );
                    const scale = targetSize / maxDim;

                    // Crear samplers normalizados para cada mesh
                    const samplers: any[] = [];
                    for (const m of meshes) {
                        const geom = m.geometry.clone();
                        geom.applyMatrix4(m.matrixWorld);
                        geom.translate(-cx, -cy, -cz);
                        geom.scale(scale, scale, scale);
                        const dummy = new Mesh(geom);
                        samplers.push(new MeshSurfaceSampler(dummy).build());
                    }
                    return samplers;
                };

                const bulbSamplers = getSamplers(bulbGLTF, 4.0);
                const brainSamplers = getSamplers(brainGLTF, 4.0);

                if (!bulbSamplers || !brainSamplers) return;

                const _position = new Vector3();
                const _normal = new Vector3();

                const pos1Array = particlesGeometry.attributes.position
                    .array as Float32Array;
                const pos2Array = particlesGeometry.attributes.position2
                    .array as Float32Array;
                const shapeArr = particlesGeometry.attributes.shapeType
                    .array as Float32Array;
                const colorArr = particlesGeometry.attributes.customColor
                    .array as Float32Array;
                const sizeArr = particlesGeometry.attributes.aSize
                    .array as Float32Array;

                // Colores por tipo de parte
                const metalColors = [
                    new Color(0xc0c0c0),
                    new Color(0x9ca3af),
                    new Color(0xe5e7eb),
                ];
                const filamentColors = [
                    new Color(0xfbbf24),
                    new Color(0xf59e0b),
                    new Color(0xffffff),
                ];
                const glassColors = [
                    new Color(0x8b5cf6),
                    new Color(0x06b6d4),
                    new Color(0xa855f7),
                    new Color(0xffffff),
                ];
                const brainMainColors = [
                    new Color(0x8b5cf6),
                    new Color(0xd946ef),
                    new Color(0x6d28d9),
                    new Color(0xffffff),
                ];
                const brainDetailColors = [
                    new Color(0xfbbf24),
                    new Color(0x06b6d4),
                    new Color(0xf59e0b),
                ];

                for (let i = 0; i < particleCount; i++) {
                    // ===== BOMBILLA (position1) =====
                    const bulbMeshIdx = i % bulbSamplers.length;
                    const bulbS = bulbSamplers[bulbMeshIdx];
                    bulbS.sample(_position, _normal);
                    pos1Array[i * 3] = _position.x;
                    pos1Array[i * 3 + 1] = _position.y;
                    pos1Array[i * 3 + 2] = _position.z;

                    // Asignar forma y color según la parte del modelo
                    // Heurística: parte baja = metal (y <-0.5), centro = filamento (pequeño radio), resto = vidrio
                    const py = _position.y;
                    const radius = Math.sqrt(
                        _position.x * _position.x + _position.z * _position.z,
                    );

                    if (py < -0.8) {
                        // Parte metálica (base/rosca) → cuadrados rotados brillantes
                        shapeArr[i] = 3;
                        const mc =
                            metalColors[
                                Math.floor(Math.random() * metalColors.length)
                            ];
                        colorArr[i * 3] = mc.r;
                        colorArr[i * 3 + 1] = mc.g;
                        colorArr[i * 3 + 2] = mc.b;
                        sizeArr[i] = Math.random() * 0.6 + 0.3;
                    } else if (radius < 0.6 && py > -0.3 && py < 1.2) {
                        // Filamento interior → puntos brillantes
                        shapeArr[i] = 2;
                        const fc =
                            filamentColors[
                                Math.floor(
                                    Math.random() * filamentColors.length,
                                )
                            ];
                        colorArr[i * 3] = fc.r;
                        colorArr[i * 3 + 1] = fc.g;
                        colorArr[i * 3 + 2] = fc.b;
                        sizeArr[i] = Math.random() * 1.5 + 0.5;
                    } else {
                        // Vidrio → triángulos outline
                        shapeArr[i] = Math.random() < 0.8 ? 1 : 0;
                        const gc =
                            glassColors[
                                Math.floor(Math.random() * glassColors.length)
                            ];
                        colorArr[i * 3] = gc.r;
                        colorArr[i * 3 + 1] = gc.g;
                        colorArr[i * 3 + 2] = gc.b;
                    }

                    // ===== CEREBRO (position2) =====
                    const brainMeshIdx = i % brainSamplers.length;
                    const brainS = brainSamplers[brainMeshIdx];
                    brainS.sample(_position, _normal);
                    pos2Array[i * 3] = _position.x;
                    pos2Array[i * 3 + 1] = _position.y;
                    pos2Array[i * 3 + 2] = _position.z;
                }

                particlesGeometry.attributes.position.needsUpdate = true;
                particlesGeometry.attributes.position2.needsUpdate = true;
                particlesGeometry.attributes.shapeType.needsUpdate = true;
                particlesGeometry.attributes.customColor.needsUpdate = true;
                particlesGeometry.attributes.aSize.needsUpdate = true;

                gsap.to(particleSystem.scale, {
                    x: 1,
                    y: 1,
                    z: 1,
                    duration: 1.5,
                    ease: "power2.out",
                });
            })
            .catch((e) => console.error("Error loading GLB:", e));

        // ========== PARTÍCULAS DE FONDO (triángulos flotantes) ==========
        const bgParticleCount = isMobile ? 80 : 200;
        const bgPositions = new Float32Array(bgParticleCount * 3);
        const bgSizes = new Float32Array(bgParticleCount);
        const bgVelocities = new Float32Array(bgParticleCount * 3);
        const bgOpacities = new Float32Array(bgParticleCount);
        const bgShapeTypes = new Float32Array(bgParticleCount);
        const bgColors = new Float32Array(bgParticleCount * 3);

        const bgColorPalette = [
            new Color(0x8b5cf6), // Púrpura
            new Color(0xfbbf24), // Dorado
            new Color(0x06b6d4), // Cyan
            new Color(0xffffff), // Blanco
            new Color(0xd946ef), // Rosa
            new Color(0xa855f7), // Púrpura claro
        ];

        for (let i = 0; i < bgParticleCount; i++) {
            bgPositions[i * 3] = (Math.random() - 0.5) * 60;
            bgPositions[i * 3 + 1] = (Math.random() - 0.5) * 40;
            bgPositions[i * 3 + 2] = (Math.random() - 0.5) * 60;

            // Triángulos de fondo más grandes y visibles
            const sr = Math.random();
            if (sr < 0.2) {
                bgSizes[i] = Math.random() * 0.5 + 0.3; // Grandes
            } else if (sr < 0.6) {
                bgSizes[i] = Math.random() * 0.2 + 0.1; // Medianos
            } else {
                bgSizes[i] = Math.random() * 0.08 + 0.03; // Pequeños
            }

            bgVelocities[i * 3] = (Math.random() - 0.5) * 0.08;
            bgVelocities[i * 3 + 1] = (Math.random() - 0.5) * 0.06;
            bgVelocities[i * 3 + 2] = (Math.random() - 0.5) * 0.08;

            bgOpacities[i] = Math.random() * 0.6 + 0.15;

            // Mayoría triángulos, algunos puntos y anillos
            const shapeR = Math.random();
            if (shapeR < 0.3)
                bgShapeTypes[i] = 0; // Triángulo outline
            else if (shapeR < 0.6)
                bgShapeTypes[i] = 1; // Triángulo relleno
            else if (shapeR < 0.85)
                bgShapeTypes[i] = 2; // Punto
            else bgShapeTypes[i] = 3; // Anillo

            const bgCol =
                bgColorPalette[
                    Math.floor(Math.random() * bgColorPalette.length)
                ];
            bgColors[i * 3] = bgCol.r;
            bgColors[i * 3 + 1] = bgCol.g;
            bgColors[i * 3 + 2] = bgCol.b;
        }

        const bgGeometry = new BufferGeometry();
        bgGeometry.setAttribute(
            "position",
            new BufferAttribute(bgPositions, 3),
        );
        bgGeometry.setAttribute("aSize", new BufferAttribute(bgSizes, 1));
        bgGeometry.setAttribute(
            "aVelocity",
            new BufferAttribute(bgVelocities, 3),
        );
        bgGeometry.setAttribute(
            "aOpacity",
            new BufferAttribute(bgOpacities, 1),
        );
        bgGeometry.setAttribute(
            "aShapeType",
            new BufferAttribute(bgShapeTypes, 1),
        );
        bgGeometry.setAttribute("aColor", new BufferAttribute(bgColors, 3));

        const bgMaterial = new ShaderMaterial({
            vertexShader: bgVertexShader,
            fragmentShader: bgFragmentShader,
            uniforms: {
                uTime: { value: 0 },
            },
            transparent: true,
            depthWrite: false,
            blending: AdditiveBlending,
        });

        const bgParticles = new Points(bgGeometry, bgMaterial);
        bgParticles.frustumCulled = false;
        scene.add(bgParticles);

        // ========== SISTEMA DE PARTÍCULAS DE MODELOS ==========
        if (vertexShader && fragmentShader) {
            const getParticleSizeFactor = () =>
                window.innerWidth < 1024 ? 30.0 : 45.0; // Multiplicador general de tamaño

            const shaderMaterial = new ShaderMaterial({
                vertexShader: vertexShader,
                fragmentShader: fragmentShader,
                uniforms: {
                    uTime: { value: 0 },
                    uProgress: { value: 0 },
                    uExplosion: { value: 0 },
                    uSizeFactor: { value: getParticleSizeFactor() },
                },
                transparent: true,
                depthWrite: false,
                blending: AdditiveBlending, // Ver a través del modelo
            });

            particleSystem = new Points(particlesGeometry, shaderMaterial);
            particleSystem.frustumCulled = false;
            particleSystem.scale.set(0, 0, 0);

            const setInitialPosition = () => {
                if (window.innerWidth < 1024) {
                    particleSystem.position.set(0, 0, 0); // Centrado verticalmente en mobile
                } else {
                    particleSystem.position.set(2.5, 0.4, 0); // Ajustado para centrar con el bloque de texto
                }
            };
            setInitialPosition();

            particleSystem.rotation.set(0.1, -0.15, -0.15); // Inclinada a la derecha

            scene.add(particleSystem);

            // Rotación continua durante el scroll
            gsap.to(particleSystem.rotation, {
                y: "+=" + Math.PI * 2,
                ease: "none",
                scrollTrigger: {
                    trigger: "main",
                    start: "top top",
                    end: "bottom bottom",
                    scrub: 1,
                },
            });

            // Transición explosiva morph
            const morphTl = gsap.timeline({
                scrollTrigger: {
                    trigger: "main",
                    start: "top top",
                    endTrigger: "#contact",
                    end: "top center",
                    scrub: 2,
                },
            });

            morphTl
                .to(
                    shaderMaterial.uniforms.uExplosion,
                    { value: 1.5, ease: "power2.in" },
                    0,
                )
                .to(
                    particleSystem.position,
                    { x: window.innerWidth < 1024 ? 0 : -2.5, ease: "none" },
                    0,
                )
                .to(
                    shaderMaterial.uniforms.uProgress,
                    { value: 1.0, duration: 0.1 },
                    0.5,
                )
                .to(
                    shaderMaterial.uniforms.uExplosion,
                    { value: 0.0, ease: "power4.out" },
                    0.8,
                );

            const clock = new Clock();
            function animate() {
                requestAnimationFrame(animate);
                const elapsedTime = clock.getElapsedTime();
                shaderMaterial.uniforms.uTime.value = elapsedTime;
                bgMaterial.uniforms.uTime.value = elapsedTime;
                composer.render();
            }
            animate();

            let resizeTimeout: ReturnType<typeof setTimeout>;
            window.addEventListener("resize", () => {
                clearTimeout(resizeTimeout);
                resizeTimeout = setTimeout(() => {
                    camera.aspect = window.innerWidth / window.innerHeight;
                    camera.updateProjectionMatrix();
                    renderer.setSize(window.innerWidth, window.innerHeight);
                    composer.setSize(window.innerWidth, window.innerHeight);
                    shaderMaterial.uniforms.uSizeFactor.value =
                        getParticleSizeFactor();
                    setInitialPosition();
                }, 250);
            });
        }
    }
</script>
