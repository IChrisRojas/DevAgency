---
// src/components/WebGLBackground.astro
---

<canvas id="webgl-canvas" class="fixed top-0 left-0 w-full h-full -z-10 pointer-events-none"></canvas>

<script id="vertexShader" type="x-shader/x-vertex">
  uniform float uTime;
  uniform float uProgress; // 0.0 = Cerebro, 1.0 = Bombilla
  uniform float uExplosion; // Controla la dispersión en la sección 2
  
  attribute vec3 position2; // Posición de la segunda geometría
  attribute vec3 customColor;
  attribute float randomOffset;
  
  varying vec3 vColor;
  
  // Función ruido simplificada
  vec3 mod289(vec3 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
  vec4 mod289(vec4 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
  vec4 permute(vec4 x) { return mod289(((x*34.0)+1.0)*x); }
  vec4 taylorInvSqrt(vec4 r) { return 1.79284291400159 - 0.85373472095314 * r; }
  float snoise(vec3 v) {
    // Ruido simple
    return sin(v.x*10.) * cos(v.y*10.) * sin(v.z*10.);
  }
  
  void main() {
      vColor = customColor;
  
      // 1. Morphing entre Geometría 1 (position) y Geometría 2 (position2)
      vec3 mixedPosition = mix(position, position2, uProgress);
  
      // 2. Ruido Perlin para movimiento constante (flotación)
      float noise = snoise(mixedPosition * 2.0 + uTime * 0.5 + randomOffset) * 0.1;
      // Aproximación pseudo-normal para partículas sin caras
      vec3 pseudoNormal = normalize(mixedPosition);
      mixedPosition += pseudoNormal * noise;
  
      // 3. Efecto Explosión (empuja hacia afuera desde el centro)
      vec3 direction = normalize(mixedPosition);
      mixedPosition += direction * uExplosion * randomOffset * 5.0;
  
      vec4 mvPosition = modelViewMatrix * vec4(mixedPosition, 1.0);
      
      // Tamaño dinámico por perspectiva y ruido
      gl_PointSize = (8.0 + noise * 10.0) * (1.0 / -mvPosition.z);
      gl_Position = projectionMatrix * mvPosition;
  }
</script>

<script id="fragmentShader" type="x-shader/x-fragment">
  varying vec3 vColor;
  
  void main() {
      // Convierte el punto en un círculo suave
      vec2 xy = gl_PointCoord.xy - vec2(0.5);
      float ll = length(xy);
      if(ll > 0.5) discard;
      
      // Borde suave para mejor efecto Bloom
      float opacity = smoothstep(0.5, 0.1, ll);
      
      gl_FragColor = vec4(vColor, opacity);
  }
</script>

<script>
  import { Scene, FogExp2, PerspectiveCamera, WebGLRenderer, Vector2, SphereGeometry, ConeGeometry, BufferGeometry, BufferAttribute, Color, ShaderMaterial, AdditiveBlending, Points, Clock } from 'three';
  import { EffectComposer } from 'three/examples/jsm/postprocessing/EffectComposer.js';
  import { RenderPass } from 'three/examples/jsm/postprocessing/RenderPass.js';
  import { UnrealBloomPass } from 'three/examples/jsm/postprocessing/UnrealBloomPass.js';
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const canvas = document.querySelector('#webgl-canvas') as HTMLCanvasElement;
  if (canvas) {
    const scene = new Scene();
    scene.fog = new FogExp2(0x000000, 0.05);

    const camera = new PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
    camera.position.z = 5;

    const renderer = new WebGLRenderer({ canvas, alpha: false, antialias: false }); // Disabled antialias for performance, bloom softens it anyway
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1)); // Cap out pixel ratio to 1 for mobile + integrate graphics perf

    const renderScene = new RenderPass(scene, camera);
    const composer = new EffectComposer(renderer);
    composer.addPass(renderScene);

    // Conditional Bloom based on device performance (disable on mobile)
    const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
    
    if (!isMobile) {
        const bloomPass = new UnrealBloomPass(new Vector2(256, 256), 1.5, 0.4, 0.85); // Dramatically reduced bloom resolution
        bloomPass.threshold = 0.2;
        bloomPass.strength = 1.2;
        bloomPass.radius = 0.5;
        composer.addPass(bloomPass);
    }

    // Malla Esférica base ("Cerebro" placeholder)
    const geometry1 = new SphereGeometry(1.5, 32, 32);
    // Malla Cónica destino ("Bombilla" placeholder)
    const geometry2 = new ConeGeometry(1.5, 3, 32, 32);
    
    // Equalize vertex counts by expanding the smaller one if necessary
    let pos1Array = Array.from(geometry1.attributes.position.array);
    let pos2Array = Array.from(geometry2.attributes.position.array);

    const maxVerticesCount = Math.max(pos1Array.length, pos2Array.length);
    
    // Pad arrays so they match exactly in length for the Shader
    while(pos1Array.length < maxVerticesCount) pos1Array.push(pos1Array[pos1Array.length - 3], pos1Array[pos1Array.length - 2], pos1Array[pos1Array.length - 1]);
    while(pos2Array.length < maxVerticesCount) pos2Array.push(pos2Array[pos2Array.length - 3], pos2Array[pos2Array.length - 2], pos2Array[pos2Array.length - 1]);

    const positions1 = new Float32Array(pos1Array);
    const positions2 = new Float32Array(pos2Array);
    const particleCount = maxVerticesCount / 3;

    const colors = new Float32Array(particleCount * 3);
    const randomOffsets = new Float32Array(particleCount);

    const colorPalette = [
        new Color(0x8b5cf6), // Violeta
        new Color(0xccff00), // Amarillo Neón
        new Color(0xffffff)  // Blanco
    ];

    for(let i = 0; i < particleCount; i++) {
        const color = colorPalette[Math.floor(Math.random() * colorPalette.length)];
        colors[i*3] = color.r;
        colors[i*3+1] = color.g;
        colors[i*3+2] = color.b;
        randomOffsets[i] = Math.random();
    }

    const particlesGeometry = new BufferGeometry();
    particlesGeometry.setAttribute('position', new BufferAttribute(positions1, 3));
    particlesGeometry.setAttribute('position2', new BufferAttribute(positions2, 3));
    particlesGeometry.setAttribute('customColor', new BufferAttribute(colors, 3));
    particlesGeometry.setAttribute('randomOffset', new BufferAttribute(randomOffsets, 1));

    const vShaderEl = document.getElementById('vertexShader');
    const fShaderEl = document.getElementById('fragmentShader');

    if(vShaderEl && fShaderEl){
      const shaderMaterial = new ShaderMaterial({
          vertexShader: vShaderEl.textContent || '',
          fragmentShader: fShaderEl.textContent || '',
          uniforms: {
              uTime: { value: 0 },
              uProgress: { value: 0 },
              uExplosion: { value: 0 }
          },
          transparent: true,
          depthWrite: false,
          blending: AdditiveBlending
      });

      const particleSystem = new Points(particlesGeometry, shaderMaterial);
      scene.add(particleSystem);

      // Scroll Animations
      const tl = gsap.timeline({
          scrollTrigger: {
              trigger: "main",
              start: "top top",
              end: "bottom bottom",
              scrub: 1
          }
      });

      tl.to(particleSystem.rotation, { y: Math.PI, duration: 2 }, 0)
        .to(shaderMaterial.uniforms.uExplosion, { value: 1.5, duration: 1, ease: "power2.inOut" }, 1)
        .to(camera.position, { z: 2, duration: 1.5, ease: "power1.inOut" }, 1)
        .to(shaderMaterial.uniforms.uExplosion, { value: 0.0, duration: 1, ease: "power2.in" }, 2)
        .to(shaderMaterial.uniforms.uProgress, { value: 1.0, duration: 1.5, ease: "power3.inOut" }, 2)
        .to(particleSystem.rotation, { y: Math.PI * 2, duration: 2 }, 2);

      const clock = new Clock();
      function animate() {
          requestAnimationFrame(animate);
          const elapsedTime = clock.getElapsedTime();
          shaderMaterial.uniforms.uTime.value = elapsedTime;
          composer.render();
      }
      animate();

      let resizeTimeout: ReturnType<typeof setTimeout>;
      window.addEventListener('resize', () => {
          clearTimeout(resizeTimeout);
          resizeTimeout = setTimeout(() => {
              camera.aspect = window.innerWidth / window.innerHeight;
              camera.updateProjectionMatrix();
              renderer.setSize(window.innerWidth, window.innerHeight);
              composer.setSize(window.innerWidth, window.innerHeight);
          }, 250);
      });
    }
  }
</script>
