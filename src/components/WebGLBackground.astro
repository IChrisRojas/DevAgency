---
// src/components/WebGLBackground.astro
---

<canvas id="webgl-canvas" class="fixed top-0 left-0 w-full h-full -z-10 pointer-events-none"></canvas>

<script id="vertexShader" type="x-shader/x-vertex">
  uniform float uTime;
  uniform float uProgress;
  uniform float uExplosion;
  
  attribute vec3 position2;
  attribute vec3 aDirection;
  attribute vec3 customColor;
  attribute float randomOffset;
  attribute float shapeType;
  attribute float aSize;
  
  varying vec3 vColor;
  varying float vShapeType;
  
  // Función ruido simplificada
  vec3 mod289(vec3 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
  vec4 mod289(vec4 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
  vec4 permute(vec4 x) { return mod289(((x*34.0)+1.0)*x); }
  vec4 taylorInvSqrt(vec4 r) { return 1.79284291400159 - 0.85373472095314 * r; }
  float snoise(vec3 v) {
    return sin(v.x*10.) * cos(v.y*10.) * sin(v.z*10.);
  }
  
  void main() {
      vColor = customColor;
      vShapeType = shapeType;
  
      vec3 mixedPosition = mix(position, position2, uProgress);
      float noise = snoise(mixedPosition * 1.5 + uTime * 0.15 + randomOffset) * 0.05;
      vec3 pseudoNormal = normalize(mixedPosition);
      mixedPosition += pseudoNormal * noise;
  
      mixedPosition += aDirection * uExplosion * 10.0;
  
      vec4 mvPosition = modelViewMatrix * vec4(mixedPosition, 1.0);
      
      gl_PointSize = (12.0 * aSize + noise * 5.0) * (1.0 / -mvPosition.z);
      gl_Position = projectionMatrix * mvPosition;
  }
</script>

<script id="fragmentShader" type="x-shader/x-fragment">
  varying vec3 vColor;
  varying float vShapeType;
  
  // Función SDF para un triángulo equilátero centrado
  // Retorna la distancia desde el punto 'p' (centro en 0,0) a los bordes de un triángulo de radio 'r'
  float sdEquilateralTriangle(in vec2 p, in float r) {
      const float k = sqrt(3.0);
      p.x = abs(p.x) - r;
      p.y = p.y + r/k;
      if( p.x + k*p.y > 0.0 ) p = vec2(p.x-k*p.y,-k*p.x-p.y)/2.0;
      p.x -= clamp( p.x, -2.0*r, 0.0 );
      return -length(p)*sign(p.y);
  }

  void main() {
      // Coordenadas locales del punto (-0.5 a 0.5)
      vec2 uv = gl_PointCoord.xy - vec2(0.5);
      
      // Orientación del triángulo: que apunte hacia arriba o rote levemente si se desea
      // Para este diseño, un triángulo equilátero estático orientado hacia arriba
      // Multiplicamos uv.y por -1 porque WebGL invierte el eje Y en gl_PointCoord
      vec2 p = vec2(uv.x, -uv.y); 

      // Ajustamos el tamaño del triángulo dentro del punto (radio)
      float radius = 0.35; 
      float d = sdEquilateralTriangle(p, radius);
      
      // Creamos un borde hueco (wireframe). 
      // Si la distancia 'd' está cerca de 0 (el borde), la opacidad es 1.
      // Definimos el grosor del borde
      float thickness = 0.05;
      
      // Antialiasing basado en la función smoothstep
      // abs(d) nos da la distancia al borde tanto por dentro como por fuera
      float edge = abs(d) - thickness;
      
      // Suavizado del borde (0.02 es el factor de suavizado)
      float opacity = 1.0 - smoothstep(0.0, 0.03, edge);

      // Descartar píxeles completamente transparentes por rendimiento
      if (opacity < 0.05) discard;
      
      // Aumentar el brillo (opcionalmente sobre-saturando el color para el Bloom)
      gl_FragColor = vec4(vColor * 1.5, opacity); 
  }
</script>

<script>
  import { Scene, FogExp2, PerspectiveCamera, WebGLRenderer, Vector2, BufferGeometry, BufferAttribute, Color, ShaderMaterial, NormalBlending, Points, Clock, Box3, Vector3 } from 'three';
  import { EffectComposer } from 'three/examples/jsm/postprocessing/EffectComposer.js';
  import { RenderPass } from 'three/examples/jsm/postprocessing/RenderPass.js';
  import { UnrealBloomPass } from 'three/examples/jsm/postprocessing/UnrealBloomPass.js';
  import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
  import { MeshSurfaceSampler } from 'three/examples/jsm/math/MeshSurfaceSampler.js';
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const canvas = document.querySelector('#webgl-canvas') as HTMLCanvasElement;
  if (canvas) {
    const scene = new Scene();
    scene.fog = new FogExp2(0x000000, 0.05);

    const camera = new PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
    camera.position.z = 5;

    const renderer = new WebGLRenderer({ canvas, alpha: false, antialias: false });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1));

    const renderScene = new RenderPass(scene, camera);
    const composer = new EffectComposer(renderer);
    composer.addPass(renderScene);

    const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
    
    if (!isMobile) {
        const bloomPass = new UnrealBloomPass(new Vector2(256, 256), 2.5, 0.5, 0.85); // Aumentado strength a 2.5 y threshold a 0.5
        bloomPass.threshold = 0.1; // Brillo más fácil de activar
        bloomPass.strength = 2.5; // Resplandor potente holográfico
        bloomPass.radius = 1.2;
        composer.addPass(bloomPass);
    }

    const particleCount = 10000; // Reducido a 10000

    const positions1 = new Float32Array(particleCount * 3);
    const positions2 = new Float32Array(particleCount * 3);
    const shapeTypes = new Float32Array(particleCount);
    const aSizes = new Float32Array(particleCount);
    const directions = new Float32Array(particleCount * 3);
    
    const colors = new Float32Array(particleCount * 3);
    const randomOffsets = new Float32Array(particleCount);

    function randomInBox(w: number, h: number, d: number, offsetX = 0, offsetY = 0, offsetZ = 0) {
        return [
            (Math.random() - 0.5) * w + offsetX,
            (Math.random() - 0.5) * h + offsetY,
            (Math.random() - 0.5) * d + offsetZ
        ];
    }

    for (let i = 0; i < particleCount; i++) {
        const [px, py, pz] = randomInBox(40.0, 40.0, 20.0, 0, 0, -5.0);
        positions1[i * 3] = px; positions1[i * 3 + 1] = py; positions1[i * 3 + 2] = pz;
        positions2[i * 3] = px; positions2[i * 3 + 1] = py; positions2[i * 3 + 2] = pz;
        
        shapeTypes[i] = Math.floor(Math.random() * 3);
        aSizes[i] = Math.random() * 10.0 + 8.0; // Triángulos más grandes para ver el hueco
        
        const theta = Math.random() * Math.PI * 2;
        const phi = Math.acos((Math.random() * 2) - 1);
        directions[i * 3] = Math.sin(phi) * Math.cos(theta);
        directions[i * 3 + 1] = Math.sin(phi) * Math.sin(theta);
        directions[i * 3 + 2] = Math.cos(phi);
        
        colors[i*3] = 0.5; colors[i*3+1] = 0.5; colors[i*3+2] = 0.5;
        randomOffsets[i] = Math.random();
    }

    const particlesGeometry = new BufferGeometry();
    particlesGeometry.setAttribute('position', new BufferAttribute(positions1, 3));
    particlesGeometry.setAttribute('position2', new BufferAttribute(positions2, 3));
    particlesGeometry.setAttribute('aDirection', new BufferAttribute(directions, 3));
    particlesGeometry.setAttribute('customColor', new BufferAttribute(colors, 3));
    particlesGeometry.setAttribute('randomOffset', new BufferAttribute(randomOffsets, 1));
    particlesGeometry.setAttribute('shapeType', new BufferAttribute(shapeTypes, 1));
    particlesGeometry.setAttribute('aSize', new BufferAttribute(aSizes, 1));

    const loader = new GLTFLoader();
    
    Promise.all([
        new Promise(resolve => loader.load('/models/lightbulb.glb', resolve)),
        new Promise(resolve => loader.load('/models/brain.glb', resolve))
    ]).then(([bulbGLTF, brainGLTF]) => {
        
        let bulbMesh, brainMesh;
        
        // Encontrar los Meshes dentro de la escena
        bulbGLTF.scene.traverse((child) => {
            if (child.isMesh) bulbMesh = child;
        });
        brainGLTF.scene.traverse((child) => {
            if (child.isMesh) brainMesh = child;
        });

        if (!bulbMesh || !brainMesh) {
            console.error("No meshes found in GLB files");
            return;
        }

        // Crear samplers
        const bulbSampler = new MeshSurfaceSampler(bulbMesh).build();
        const brainSampler = new MeshSurfaceSampler(brainMesh).build();

        // Calcular Bounding Box del cerebro para los colores espaciales
        brainMesh.geometry.computeBoundingBox();
        const brainBox = brainMesh.geometry.boundingBox;
        const center = new Vector3();
        brainBox.getCenter(center);
        const maxDist = Math.max(
            Math.abs(brainBox.max.x - center.x),
            Math.abs(brainBox.max.y - center.y),
            Math.abs(brainBox.max.z - center.z)
        );

        const _position = new Vector3();
        const _normal = new Vector3(); // Required by sampler, but we may not use it
        
        // Colores: Amarillo neón/naranja (centro) a Púrpura/Azul (bordes)
        const colorCenter = new Color(0xffaa00); // Naranja cálido/Amarillo
        const colorEdge = new Color(0x6b21a8); // Púrpura vibrante
        const colorHighlight = new Color(0x00d8ff); // Celeste para detalles
        
        const tempColor = new Color();

        const newPos1 = new Float32Array(particleCount * 3);
        const newPos2 = new Float32Array(particleCount * 3);
        const newColors = new Float32Array(particleCount * 3);

        for (let i = 0; i < particleCount; i++) {
            // Muestrear Bombilla
            bulbSampler.sample(_position, _normal);
            // Escalar y posicionar la bombilla si es necesario. (Ej: escalar x2)
            newPos1[i * 3] = _position.x * 2.5;
            newPos1[i * 3 + 1] = (_position.y * 2.5) - 1.0; // Bajarla un poco
            newPos1[i * 3 + 2] = _position.z * 2.5;

            // Muestrear Cerebro
            brainSampler.sample(_position, _normal);
            // Escalar el cerebro
            const brainScale = 2.0;
            newPos2[i * 3] = _position.x * brainScale;
            newPos2[i * 3 + 1] = _position.y * brainScale;
            newPos2[i * 3 + 2] = _position.z * brainScale;

            // Calcular Color espacial basado en la distancia al centro del cerebro
            const distToCenter = _position.distanceTo(center);
            // Normalizar distancia de 0.0 (centro) a 1.0 (borde)
            let normalizedDist = Math.min(distToCenter / maxDist, 1.0);
            
            // Mezclar colores: Centro -> Borde
            tempColor.copy(colorCenter).lerp(colorEdge, normalizedDist);
            
            // Añadir un poco de aleatoriedad (highlight)
            if (Math.random() > 0.85) {
                tempColor.lerp(colorHighlight, 0.7);
            }

            newColors[i * 3] = tempColor.r;
            newColors[i * 3 + 1] = tempColor.g;
            newColors[i * 3 + 2] = tempColor.b;
        }

        // Actualizar la geometría
        particlesGeometry.setAttribute('position', new BufferAttribute(newPos1, 3));
        particlesGeometry.setAttribute('position2', new BufferAttribute(newPos2, 3));
        particlesGeometry.setAttribute('customColor', new BufferAttribute(newColors, 3));
        
        particlesGeometry.attributes.position.needsUpdate = true;
        particlesGeometry.attributes.position2.needsUpdate = true;
        particlesGeometry.attributes.customColor.needsUpdate = true;
        
        // Disparar una animación inicial suave para que los puntos viajen a su lugar
        // Asumiendo que uProgress empieza en 0, si quisieramos que viajaran
        // podemos animar el progress de 1 a 0 u otro truco, pero aquí simplemente 
        // dejamos que uProgress siga el Scroll normal.
        
    }).catch(e => console.error("Error loading GLB models:", e));

    const vShaderEl = document.getElementById('vertexShader');
    const fShaderEl = document.getElementById('fragmentShader');

    if(vShaderEl && fShaderEl){
      const shaderMaterial = new ShaderMaterial({
          vertexShader: vShaderEl.textContent || '',
          fragmentShader: fShaderEl.textContent || '',
          uniforms: {
              uTime: { value: 0 },
              uProgress: { value: 0 },
              uExplosion: { value: 0 }
          },
          transparent: true,
          depthWrite: false,
          blending: NormalBlending
      });

      const particleSystem = new Points(particlesGeometry, shaderMaterial);
      
      const setInitialPosition = () => {
          if (window.innerWidth < 768) {
              particleSystem.position.set(0, -1, 0);
          } else {
              particleSystem.position.set(2.5, 0, 0); // Mover a la derecha
          }
      };
      setInitialPosition();
      
      // Rotación inicial base
      particleSystem.rotation.set(0.1, -0.2, 0);
      
      scene.add(particleSystem);

      // Rotación continua durante el scroll de toda la página
      gsap.to(particleSystem.rotation, {
          y: "+=" + Math.PI * 2,
          ease: "none",
          scrollTrigger: {
              trigger: "main",
              start: "top top",
              end: "bottom bottom",
              scrub: 1
          }
      });

      // Transición explosiva: Explota, se dispersa y luego se reensambla
      const morphTl = gsap.timeline({
          scrollTrigger: {
              trigger: "main",
              start: "top top",
              endTrigger: "#contact",
              end: "top center",
              scrub: 2 // Scrub más largo para mayor fluidez
          }
      });

      morphTl
          .to(shaderMaterial.uniforms.uExplosion, { value: 15.0, ease: "power2.in" }, 0) // Explota violentamente
          .to(particleSystem.position, { x: window.innerWidth < 768 ? 0 : -2.5, ease: "none" }, 0)
          .to(shaderMaterial.uniforms.uProgress, { value: 1.0, duration: 0.1 }, 0.5) // Cambia de forma mientras está disperso
          .to(shaderMaterial.uniforms.uExplosion, { value: 0.0, ease: "power4.out" }, 0.8); // Colapsa rápidamente en el cerebro

      const clock = new Clock();
      function animate() {
          requestAnimationFrame(animate);
          const elapsedTime = clock.getElapsedTime();
          shaderMaterial.uniforms.uTime.value = elapsedTime;
          composer.render();
      }
      animate();

      let resizeTimeout: ReturnType<typeof setTimeout>;
      window.addEventListener('resize', () => {
          clearTimeout(resizeTimeout);
          resizeTimeout = setTimeout(() => {
              camera.aspect = window.innerWidth / window.innerHeight;
              camera.updateProjectionMatrix();
              renderer.setSize(window.innerWidth, window.innerHeight);
              composer.setSize(window.innerWidth, window.innerHeight);
              setInitialPosition();
          }, 250);
      });
    }
  }
</script>