---
// src/components/Header.astro
---

<header
    class="fixed top-0 w-full bg-black/50 backdrop-blur-md z-50 border-b border-white/10"
>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-20">
            <!-- Logo -->
            <div class="flex-shrink-0 flex items-center">
                <a
                    href="/"
                    class="text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-white to-slate-400"
                >
                    DevAgency
                </a>
            </div>

            <nav class="hidden md:flex space-x-8">
                <a
                    href="#services"
                    class="text-slate-300 hover:text-white transition-colors font-medium"
                    >Services</a
                >
                <a
                    href="#why-us"
                    class="text-slate-300 hover:text-white transition-colors font-medium"
                    >Why Us</a
                >
                <a
                    href="#portfolio"
                    class="text-slate-300 hover:text-white transition-colors font-medium"
                    >Portfolio</a
                >
            </nav>

            <!-- CTA Button -->
            <div class="hidden md:flex items-center">
                <a
                    href="#contact"
                    class="inline-flex items-center justify-center px-6 py-2.5 border border-transparent text-sm font-medium rounded-full text-white bg-dev-accent hover:bg-violet-600 shadow-sm shadow-dev-accent/20 hover:shadow-dev-accent/40 hover:scale-105 transition-all duration-300"
                >
                    Get Started
                </a>
            </div>

            <div class="flex items-center md:hidden">
                <button
                    type="button"
                    class="text-slate-300 hover:text-white focus:outline-none"
                    aria-controls="mobile-menu"
                    aria-expanded="false"
                >
                    <span class="sr-only">Open main menu</span>
                    <svg
                        class="h-6 w-6"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>
            </div>
        </div>
    </div>
</header>
