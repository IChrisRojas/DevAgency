---
// src/components/Header.astro
---

<header
    class="fixed top-0 w-full bg-black/50 backdrop-blur-md z-50 border-b border-white/10"
>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-20">
            <!-- Logo -->
            <div class="flex-shrink-0 flex items-center">
                <a
                    href="/"
                    class="text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-white to-slate-400"
                >
                    aisolucion.cl
                </a>
            </div>

            <!-- Header Utility (Mobile-First) -->
            <div class="flex items-center">
                <a
                    href="#contact"
                    aria-label="Ir a la sección de contacto"
                    class="label-mono text-dev-accent hover:text-white transition-colors border border-dev-accent/20 px-4 py-2 hover:bg-dev-accent/10"
                >
                    CONTACTO
                </a>
            </div>
        </div>
    </div>
</header>
