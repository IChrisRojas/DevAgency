---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import WhyChooseUs from "../components/WhyChooseUs.astro";
import Portfolio from "../components/Portfolio.astro";
import ContactForm from "../components/ContactForm.tsx";
import Footer from "../components/Footer.astro";
---

<Layout title="DevAgency | Desarrollo de Soluciones Informáticas">
	<Header />

	<main class="flex-grow pt-20">
		<Hero />

		<Services />

		<WhyChooseUs />

		<Portfolio />

		<!-- Mobile-only spacer to allow the Brain model to construct before reaching the contact form -->
		<div
			id="mobile-brain-space"
			class="block lg:hidden h-[60vh] w-full relative z-0"
		>
		</div>

		<ContactForm client:visible />
	</main>

	<Footer />
</Layout>

<script>
	// Add Lenis for smooth scrolling identical to premium references
	// We'll dynamically import lenis if the user added it, otherwise we rely on generic smooth scroll.
	// Actually, standard CSS scroll-behavior: smooth in tailwind handles most of it gracefully,
	// but let's ensure intersection observers re-trigger properly if needed.
</script>
